# TeleCMI Browser Calling (PIOPIY WebRTC SDK)
# Copy this file to ".env" in the project root (same folder as package.json)
# and fill in real values from your TeleCMI account.
#
# These are DIFFERENT from the App ID / App Secret you enter in
# Settings > Integrations > Telephony — those are used by the backend
# (server.js) to call the TeleCMI REST API and list agents. The three
# values below are used by the BROWSER to log the calling SDK itself in,
# so a staff member can actually place/receive WebRTC calls.

VITE_TELECMI_AGENT_USER_ID=5018_33336051
VITE_TELECMI_AGENT_PASSWORD=admin@123
VITE_TELECMI_SBC=sbcind.telecmi.com
